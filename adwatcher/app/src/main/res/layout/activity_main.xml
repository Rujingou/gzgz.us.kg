<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_desc"
        android:textSize="13sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvServiceState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        tools:text="无障碍服务：未启用" />

    <Button
        android:id="@+id/btnOpenAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_open_accessibility" />

    <Button
        android:id="@+id/btnOpenNotifSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_notif" />

    <Button
        android:id="@+id/btnAdbHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_adb_hint" />

    <Button
        android:id="@+id/btnClearLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_clear_log" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/log_title"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/logView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:padding="8dp"
        android:background="#11000000"
        android:gravity="bottom"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:scrollbars="vertical"
        tools:text="12:00:00  日志将显示在这里" />

</LinearLayout>
